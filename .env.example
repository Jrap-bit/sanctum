POSTGRES_PASSWORD=sanctum_local
CLINIC_TIMEZONE=Asia/Kolkata
STORE_BACKEND=filesystem
# Runtimes: host Ollama http://host.docker.internal:11434/v1, Docker Model Runner http://model-runner.docker.internal/v1, CPU profile http://llm:11434/v1
LLM_ENGINE=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
SUMMARY_MODEL=qwen3:4b
LLM_MODELS=["qwen3:4b","qwen3:1.7b","llama3.2:3b","gemma4:e2b"]
TEXT_EXTRACTOR=pdfium
OCR_ENGINE=tesseract
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Only used when STORE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=sanctum-originals
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

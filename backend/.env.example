DATABASE_URL=postgresql+psycopg://sanctum:sanctum_local@localhost:5433/sanctum
ALLOWED_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=8
CLINIC_TIMEZONE=Asia/Kolkata
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
ACTIVATION_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=30

# Local OCR executable and installed language code(s)
TESSERACT_COMMAND=tesseract
OCR_LANGUAGE=eng

# Local-only AI summary model (must already be installed in Ollama)
OLLAMA_URL=http://127.0.0.1:11434
SUMMARY_MODEL=qwen3:8b
